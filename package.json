{
  "name": "dsh-alist",
  "version": "0.1.6",
  "description": "AList v3 control for DeepSeek Harness: browse, search, upload and administrate an AList instance (files, tasks, storages, users, roles, meta, settings, index, shares) through conversation.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && node --check catalog.js && node --check client.js && node --check test/index.test.js && node scripts/check-exports.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "files": [
    "index.js",
    "catalog.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "alist",
    "file-manager",
    "webdav"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R-roker315/dsh-Alist-.git"
  },
  "bugs": {
    "url": "https://github.com/R-roker315/dsh-Alist-/issues"
  },
  "homepage": "https://github.com/R-roker315/dsh-Alist-#readme"
}
